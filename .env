# =============================================================================
# Docker deployment — copy to .env in the project root:
#   cp .env.docker.example .env
# =============================================================================

# ── Database (PostgreSQL container) ─────────────────────────────────────────
POSTGRES_USER=jo
POSTGRES_PASSWORD=postgress
POSTGRES_DB=esrom

# ── Backend secrets (use long random strings in production) ─────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
AES_SECRET=change-me-aes-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Network / access ──────────────────────────────────────────────────────────
# Port exposed on the client PC (default 80 — users open http://192.168.x.x/)
APP_PORT=80

# LAN URL users will use (set to your server PC's IP, e.g. http://192.168.1.50)
#192.168.25.214
CORS_ORIGIN=http://192.168.25.214
